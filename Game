<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Ocean Explorer — Ultra Photorealistic Edition</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #010c17;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #ffffff;
      user-select: none;
    }

    #game {
      position: fixed;
      inset: 0;
    }

    #game canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* Cinematic Vignette & Lens Dirt Overlay */
    #vignette {
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 58%, rgba(0, 8, 18, 0.72) 100%);
      z-index: 2;
    }

    /* Next-Gen Glassmorphism HUD */
    #hud {
      position: fixed;
      top: 18px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      pointer-events: none;
      z-index: 10;
    }

    .hud-group {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .pill {
      background: linear-gradient(135deg, rgba(6, 28, 48, 0.68), rgba(2, 14, 26, 0.82));
      border: 1px solid rgba(120, 225, 255, 0.35);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.15);
      border-radius: 14px;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.6px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pill b {
      color: #ffd859;
      font-size: 15px;
      text-shadow: 0 0 10px rgba(255, 216, 89, 0.6);
    }

    .depth-meter {
      color: #7ee8ff;
      font-variant-numeric: tabular-nums;
    }

    #hint {
      position: fixed;
      top: 72px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(2, 18, 34, 0.55);
      border: 1px solid rgba(138, 223, 255, 0.2);
      padding: 6px 16px;
      border-radius: 99px;
      color: #d4f6ff;
      font-size: 12.5px;
      letter-spacing: 0.4px;
      backdrop-filter: blur(6px);
      z-index: 10;
      pointer-events: none;
      text-align: center;
    }

    /* Controls */
    #controls {
      position: fixed;
      bottom: 22px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 0 24px;
      pointer-events: none;
      z-index: 10;
    }

    .pad {
      display: grid;
      grid-template-columns: repeat(3, 52px);
      grid-template-rows: repeat(3, 52px);
      gap: 6px;
      pointer-events: auto;
    }

    button {
      border: 1px solid rgba(160, 235, 255, 0.45);
      background: linear-gradient(180deg, rgba(12, 65, 102, 0.65), rgba(4, 30, 52, 0.85));
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
      color: #ffffff;
      border-radius: 14px;
      font-size: 18px;
      font-weight: 700;
      touch-action: none;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: transform 0.08s ease, background 0.15s ease, box-shadow 0.15s ease;
    }

    button:hover {
      border-color: rgba(160, 235, 255, 0.85);
      box-shadow: 0 0 18px rgba(56, 189, 248, 0.45);
    }

    button:active {
      transform: scale(0.94);
      background: #0ea5e9;
    }

    .up    { grid-column: 2; grid-row: 1; }
    .left  { grid-column: 1; grid-row: 2; }
    .down  { grid-column: 2; grid-row: 2; }
    .right { grid-column: 3; grid-row: 2; }

    .vertical {
      display: flex;
      flex-direction: column;
      gap: 8px;
      pointer-events: auto;
    }

    .vertical button {
      width: 68px;
      height: 52px;
      font-size: 12px;
      letter-spacing: 1px;
    }

    .boost-btn {
      border-color: rgba(255, 200, 80, 0.6) !important;
      background: linear-gradient(180deg, rgba(180, 110, 10, 0.65), rgba(90, 45, 5, 0.85)) !important;
      color: #ffe89e !important;
    }

    /* Cinematic Modal */
    #message {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at center, rgba(2, 22, 42, 0.68), rgba(0, 8, 18, 0.92));
      backdrop-filter: blur(10px);
      padding: 24px;
      text-align: center;
      z-index: 20;
    }

    #panel {
      max-width: 430px;
      background: linear-gradient(145deg, rgba(8, 42, 70, 0.88), rgba(3, 18, 34, 0.95));
      border: 1px solid rgba(130, 225, 255, 0.45);
      border-radius: 26px;
      padding: 32px 28px;
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 99px;
      background: rgba(14, 165, 233, 0.2);
      border: 1px solid rgba(56, 189, 248, 0.45);
      color: #7dd3fc;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    #panel h1 {
      margin: 0 0 12px;
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: linear-gradient(180deg, #ffffff 0%, #93e4ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    #panel p {
      line-height: 1.55;
      color: #cbeeff;
      font-size: 14.5px;
      margin: 0 0 16px;
    }

    #start, #again {
      padding: 14px 32px;
      font-size: 16px;
      letter-spacing: 0.5px;
      border-radius: 16px;
      background: linear-gradient(135deg, #0284c7, #0ea5e9);
      border: 1px solid rgba(186, 230, 253, 0.7);
      box-shadow: 0 10px 25px rgba(14, 165, 233, 0.45);
      margin-top: 6px;
    }

    .small {
      font-size: 12px !important;
      color: #8ccae0 !important;
      background: rgba(0, 15, 30, 0.45);
      padding: 10px 14px;
      border-radius: 12px;
      border: 1px solid rgba(130, 225, 255, 0.15);
    }
  </style>

  <!-- Import Map for Three.js + Post-Processing Shaders -->
  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
      }
    }
  </script>
</head>
<body>
  <div id="game"></div>
  <div id="vignette"></div>

  <div id="hud">
    <div class="hud-group">
      <div class="pill">🌊 ABYSSAL EXPLORER <span style="opacity:0.5">|</span> <span class="depth-meter" id="depth">DEPTH: 42m</span></div>
    </div>
    <div class="hud-group">
      <div class="pill">💎 RELICS: <b id="score">0</b>/5</div>
    </div>
  </div>

  <div id="hint">Use spotlight & sonar pulse to locate all 5 sunken relics across the reef.</div>

  <div id="controls">
    <div class="pad">
      <button type="button" class="up" data-key="forward">▲</button>
      <button type="button" class="left" data-key="left">◀</button>
      <button type="button" class="down" data-key="back">▼</button>
      <button type="button" class="right" data-key="right">▶</button>
    </div>
    <div class="vertical">
      <button type="button" class="boost-btn" data-key="boost">TURBO</button>
      <button type="button" data-key="rise">RISE</button>
      <button type="button" data-key="dive">DIVE</button>
    </div>
  </div>

  <div id="message">
    <div id="panel">
      <div class="badge">Next-Gen WebGL Render</div>
      <h1>Ocean Explorer</h1>
      <p>Descend into a photorealistic volcanic reef bathed in volumetric god-rays, shimmering water caustics, and bioluminescent flora. Recover all five ancient relics.</p>
      <p class="small"><b>Controls:</b> WASD / Arrows to steer • Q / E to Rise & Dive • Shift for Turbine Boost • L to Toggle Floodlights</p>
      <button type="button" id="start">Dive Into Reef</button>
    </div>
  </div>

  <script type="module">
    import * as THREE from 'three';
    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
    import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

    const container = document.getElementById("game");
    const scoreDisplay = document.getElementById("score");
    const depthDisplay = document.getElementById("depth");
    const overlay = document.getElementById("message");
    const dialogBox = document.getElementById("panel");
    const startButton = document.getElementById("start");

    const TOTAL_TREASURES = 5;
    const PICKUP_RADIUS = 1.65;

    // 1. PHOTOREALISTIC RENDERER WITH ACES FILMIC TONE MAPPING & SHADOWS
    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      powerPreference: "high-performance"
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);

    // 2. SCENE, VOLUMETRIC DEPTH FOG & PROCEDURAL SKY/OCEAN GRADIENT
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x03263d);
    scene.fog = new THREE.FogExp2(0x03263d, 0.022);

    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 160);
    camera.position.set(0, 4, 12);

    // 3. POST-PROCESSING BLOOM FOR CINEMATIC GLOWS & SUN SHIMMER
    const composer = new EffectComposer(renderer);
    const renderPass = new RenderPass(scene, camera);
    composer.addPass(renderPass);

    const bloomPass = new UnrealBloomPass(
      new THREE.Vector2(window.innerWidth, window.innerHeight),
      0.55, // strength
      0.75, // radius
      0.72  // threshold
    );
    composer.addPass(bloomPass);

    // 4. PROCEDURAL PBR TEXTURES (SAND NORMALS, BUMP MAPS & ANIMATED CAUSTICS)
    function createProceduralTextures() {
      // Sand Height/Bump & Albedo Texture
      const size = 512;
      const sandCanvas = document.createElement('canvas');
      sandCanvas.width = size;
      sandCanvas.height = size;
      const sCtx = sandCanvas.getContext('2d');

      const bumpCanvas = document.createElement('canvas');
      bumpCanvas.width = size;
      bumpCanvas.height = size;
      const bCtx = bumpCanvas.getContext('2d');

      const sImg = sCtx.createImageData(size, size);
      const bImg = bCtx.createImageData(size, size);

      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const i = (y * size + x) * 4;
          // Ocean current sand ripples + fine mineral grain
          const wave = Math.sin(x * 0.06 + Math.sin(y * 0.03) * 2.5) * 0.5 + 0.5;
          const micro = (Math.sin(x * 0.4) * Math.cos(y * 0.4)) * 0.15;
          const grain = (Math.random() - 0.5) * 0.18;
          const h = Math.max(0, Math.min(1, wave * 0.65 + micro + grain + 0.2));

          // Warm realistic underwater sand color
          sImg.data[i]     = 28 + h * 36;
          sImg.data[i + 1] = 68 + h * 54;
          sImg.data[i + 2] = 74 + h * 52;
          sImg.data[i + 3] = 255;

          const bVal = Math.floor(h * 255);
          bImg.data[i] = bVal;
          bImg.data[i + 1] = bVal;
          bImg.data[i + 2] = bVal;
          bImg.data[i + 3] = 255;
        }
      }
      sCtx.putImageData(sImg, 0, 0);
      bCtx.putImageData(bImg, 0, 0);

      const sandMap = new THREE.CanvasTexture(sandCanvas);
      sandMap.wrapS = sandMap.wrapT = THREE.RepeatWrapping;
      sandMap.repeat.set(18, 18);
      sandMap.colorSpace = THREE.SRGBColorSpace;

      const sandBump = new THREE.CanvasTexture(bumpCanvas);
      sandBump.wrapS = sandBump.wrapT = THREE.RepeatWrapping;
      sandBump.repeat.set(18, 18);

      // Animated Water Caustics Texture (Voronoi-style interference)
      const cSize = 256;
      const causticsCanvas = document.createElement('canvas');
      causticsCanvas.width = cSize;
      causticsCanvas.height = cSize;
      const cCtx = causticsCanvas.getContext('2d');
      const causticsTex = new THREE.CanvasTexture(causticsCanvas);
      causticsTex.wrapS = causticsTex.wrapT = THREE.RepeatWrapping;
      causticsTex.repeat.set(6, 6);

      // Pre-generate seamless caustic cellular points
      const pts = [];
      for (let p = 0; p < 28; p++) {
        pts.push({
          x: Math.random() * cSize,
          y: Math.random() * cSize,
          vx: (Math.random() - 0.5) * 1.4,
          vy: (Math.random() - 0.5) * 1.4
        });
      }

      function updateCaustics(time) {
        const img = cCtx.createImageData(cSize, cSize);
        const data = img.data;
        // Move points smoothly
        for (let p = 0; p < pts.length; p++) {
          pts[p].px = (pts[p].x + Math.sin(time * 0.8 + p) * 22 + cSize) % cSize;
          pts[p].py = (pts[p].y + Math.cos(time * 0.7 + p * 1.3) * 22 + cSize) % cSize;
        }

        for (let y = 0; y < cSize; y += 2) {
          for (let x = 0; x < cSize; x += 2) {
            let d1 = 999999;
            let d2 = 999999;
            for (let p = 0; p < pts.length; p++) {
              let dx = Math.abs(x - pts[p].px);
              let dy = Math.abs(y - pts[p].py);
              if (dx > cSize * 0.5) dx = cSize - dx;
              if (dy > cSize * 0.5) dy = cSize - dy;
              const dist = dx * dx + dy * dy;
              if (dist < d1) {
                d2 = d1;
                d1 = dist;
              } else if (dist < d2) {
                d2 = dist;
              }
            }
            const edge = Math.sqrt(d2) - Math.sqrt(d1);
            const intensity = Math.pow(Math.max(0, 1 - edge / 14), 3.2);
            const r = Math.min(255, intensity * 170);
            const g = Math.min(255, intensity * 245);
            const b = Math.min(255, intensity * 255);

            // Fill 2x2 block for crisp 60fps performance
            for (let oy = 0; oy < 2; oy++) {
              for (let ox = 0; ox < 2; ox++) {
                const idx = ((y + oy) * cSize + (x + ox)) * 4;
                data[idx] = r;
                data[idx + 1] = g;
                data[idx + 2] = b;
                data[idx + 3] = 255;
              }
            }
          }
        }
        cCtx.putImageData(img, 0, 0);
        causticsTex.needsUpdate = true;
      }

      return { sandMap, sandBump, causticsTex, updateCaustics };
    }

    const { sandMap, sandBump, causticsTex, updateCaustics } = createProceduralTextures();
    updateCaustics(0);

    // 5. STUDIO-GRADE UNDERWATER LIGHTING & GOD RAYS
    const hemiLight = new THREE.HemisphereLight(0x6be4ff, 0x041829, 1.45);
    scene.add(hemiLight);

    // Primary Sun Directional Light with High-Res Soft Shadows
    const sunLight = new THREE.DirectionalLight(0xa6f0ff, 2.8);
    sunLight.position.set(-14, 28, 12);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 2048;
    sunLight.shadow.mapSize.height = 2048;
    sunLight.shadow.camera.near = 2;
    sunLight.shadow.camera.far = 75;
    const d = 32;
    sunLight.shadow.camera.left = -d;
    sunLight.shadow.camera.right = d;
    sunLight.shadow.camera.top = d;
    sunLight.shadow.camera.bottom = -d;
    sunLight.shadow.bias = -0.0005;
    scene.add(sunLight);

    // Volumetric Sunbeams (God Rays) piercing from surface
    const godRays = [];
    const rayGeo = new THREE.ConeGeometry(4.5, 34, 24, 1, true);
    const rayMat = new THREE.MeshBasicMaterial({
      color: 0x7be8ff,
      transparent: true,
      opacity: 0.055,
      side: THREE.DoubleSide,
      depthWrite: false,
      blending: THREE.AdditiveBlending
    });

    for (let i = 0; i < 12; i++) {
      const ray = new THREE.Mesh(rayGeo, rayMat);
      ray.position.set(
        (Math.random() - 0.5) * 44,
        10,
        (Math.random() - 0.5) * 44
      );
      ray.rotation.z = -0.22;
      ray.rotation.x = 0.15;
      ray.scale.set(0.7 + Math.random() * 1.1, 1, 0.7 + Math.random() * 1.1);
      scene.add(ray);
      godRays.push({ mesh: ray, phase: Math.random() * Math.PI * 2 });
    }

    // Shimmering Ocean Surface Overhead
    const surfaceGeo = new THREE.PlaneGeometry(140, 140, 32, 32);
    const surfaceMat = new THREE.MeshBasicMaterial({
      color: 0x5ce1ff,
      map: causticsTex,
      transparent: true,
      opacity: 0.42,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide
    });
    const oceanSurface = new THREE.Mesh(surfaceGeo, surfaceMat);
    oceanSurface.rotation.x = Math.PI / 2;
    oceanSurface.position.y = 14;
    scene.add(oceanSurface);

    // 6. SCULPTED 3D SEABED WITH DUNES, TRENCHES & CAUSTICS PROJECTION
    const floorGeo = new THREE.PlaneGeometry(130, 130, 96, 96);
    const posAttr = floorGeo.attributes.position;
    for (let i = 0; i < posAttr.count; i++) {
      const x = posAttr.getX(i);
      const y = posAttr.getY(i);
      const ridge = Math.sin(x * 0.14) * Math.cos(y * 0.14) * 1.35;
      const detail = Math.sin(x * 0.45 + y * 0.3) * 0.25;
      const bowl = Math.max(0, (Math.hypot(x, y) - 22) * 0.18); // Natural reef basin walls
      posAttr.setZ(i, ridge + detail + bowl);
    }
    floorGeo.computeVertexNormals();

    const seabedMat = new THREE.MeshStandardMaterial({
      map: sandMap,
      bumpMap: sandBump,
      bumpScale: 0.22,
      roughness: 0.88,
      metalness: 0.05
    });
    const seabed = new THREE.Mesh(floorGeo, seabedMat);
    seabed.rotation.x = -Math.PI / 2;
    seabed.position.y = -5.2;
    seabed.receiveShadow = true;
    scene.add(seabed);

    // Projected Caustics Layer over the Seabed
    const causticsFloorMat = new THREE.MeshBasicMaterial({
      map: causticsTex,
      transparent: true,
      opacity: 0.32,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const causticsFloor = new THREE.Mesh(floorGeo, causticsFloorMat);
    causticsFloor.rotation.x = -Math.PI / 2;
    causticsFloor.position.y = -5.16;
    scene.add(causticsFloor);

    // 7. ORGANIC VOLCANIC BOULDERS & CORAL REEF FORMATIONS
    function createOrganicRock(radius, colorHex) {
      const geo = new THREE.IcosahedronGeometry(radius, 2);
      const p = geo.attributes.position;
      const v = new THREE.Vector3();
      for (let i = 0; i < p.count; i++) {
        v.fromBufferAttribute(p, i);
        const noise =
          Math.sin(v.x * 3.1 + radius) * 0.18 +
          Math.cos(v.y * 4.2) * 0.15 +
          Math.sin(v.z * 2.7) * 0.18;
        v.multiplyScalar(1 + noise);
        p.setXYZ(i, v.x, v.y, v.z);
      }
      geo.computeVertexNormals();
      const mat = new THREE.MeshStandardMaterial({
        color: colorHex,
        bumpMap: sandBump,
        bumpScale: 0.08,
        roughness: 0.92,
        metalness: 0.08
      });
      const mesh = new THREE.Mesh(geo, mat);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      return mesh;
    }

    const rockColors = [0x1c3d47, 0x244952, 0x2d4a46, 0x18323c];
    for (let i = 0; i < 60; i++) {
      const r = 0.45 + Math.random() * 1.45;
      const rock = createOrganicRock(r, rockColors[i % rockColors.length]);
      rock.position.set(
        (Math.random() - 0.5) * 52,
        -4.8 + r * 0.3,
        (Math.random() - 0.5) * 52
      );
      rock.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
      rock.scale.set(1 + Math.random() * 0.4, 0.6 + Math.random() * 0.6, 1 + Math.random() * 0.4);
      scene.add(rock);
    }

    // Swaying Kelp Forests & Glowing Anemones
    const kelpStalks = [];
    const kelpMat = new THREE.MeshStandardMaterial({
      color: 0x167a63,
      roughness: 0.6,
      side: THREE.DoubleSide
    });
    const coralGlowColors = [0xff4d8d, 0x00f5d4, 0xff9e00, 0x9b5de5];

    for (let i = 0; i < 42; i++) {
      const px = (Math.random() - 0.5) * 44;
      const pz = (Math.random() - 0.5) * 44;

      // Kelp cluster
      for (let s = 0; s < 3; s++) {
        const h = 1.6 + Math.random() * 2.8;
        const bladeGeo = new THREE.PlaneGeometry(0.24, h, 2, 8);
        bladeGeo.translate(0, h / 2, 0);
        const blade = new THREE.Mesh(bladeGeo, kelpMat);
        blade.position.set(px + (Math.random() - 0.5) * 0.6, -5.1, pz + (Math.random() - 0.5) * 0.6);
        blade.rotation.y = Math.random() * Math.PI;
        blade.castShadow = true;
        scene.add(blade);
        kelpStalks.push({ mesh: blade, phase: Math.random() * Math.PI * 2 });
      }

      // Bioluminescent Tube Coral every few clusters
      if (i % 3 === 0) {
        const cColor = coralGlowColors[i % coralGlowColors.length];
        const coralMat = new THREE.MeshStandardMaterial({
          color: cColor,
          emissive: cColor,
          emissiveIntensity: 0.85,
          roughness: 0.4
        });
        const coral = new THREE.Mesh(new THREE.TorusKnotGeometry(0.26, 0.08, 36, 8, 2, 3), coralMat);
        coral.position.set(px + 0.5, -4.7, pz - 0.4);
        scene.add(coral);
      }
    }

    // 8. DETAILED DEEP-SEA BATHYSCAPHE SUBMARINE WITH SPOTLIGHT & SPINNING PROPELLER
    const subGroup = new THREE.Group();
    scene.add(subGroup);

    const yellowHull = new THREE.MeshStandardMaterial({
      color: 0xf5b014,
      metalness: 0.55,
      roughness: 0.24,
      clearcoat: 0.8,
      clearcoatRoughness: 0.15
    });
    const darkCarbon = new THREE.MeshStandardMaterial({
      color: 0x112533,
      metalness: 0.75,
      roughness: 0.28
    });
    const acrylicDome = new THREE.MeshPhysicalMaterial({
      color: 0xbef5ff,
      metalness: 0.05,
      roughness: 0.05,
      transmission: 0.82,
      transparent: true,
      opacity: 0.88,
      ior: 1.45
    });

    // Main Pressure Hull
    const mainHull = new THREE.Mesh(new THREE.CapsuleGeometry(0.65, 1.85, 12, 24), yellowHull);
    mainHull.rotation.z = Math.PI / 2;
    mainHull.castShadow = true;
    subGroup.add(mainHull);

    // Front Acrylic Observation Dome + Interior Cockpit Glow
    const dome = new THREE.Mesh(new THREE.SphereGeometry(0.56, 24, 18), acrylicDome);
    dome.position.set(1.02, 0.04, 0);
    dome.scale.set(1.15, 0.92, 0.92);
    subGroup.add(dome);

    const cockpitLight = new THREE.PointLight(0x38bdf8, 1.8, 3.5);
    cockpitLight.position.set(0.9, 0.1, 0);
    subGroup.add(cockpitLight);

    // Hull Reinforcement Ribs
    [-0.45, 0.15, 0.68].forEach((rx) => {
      const rib = new THREE.Mesh(new THREE.TorusGeometry(0.66, 0.035, 10, 28), darkCarbon);
      rib.position.x = rx;
      rib.rotation.y = Math.PI / 2;
      subGroup.add(rib);
    });

    // Conning Tower & Periscope
    const tower = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.34, 0.65, 16), yellowHull);
    tower.position.set(-0.25, 0.72, 0);
    tower.castShadow = true;
    subGroup.add(tower);

    const periscope = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 0.45, 10), darkCarbon);
    periscope.position.set(-0.2, 1.1, 0);
    subGroup.add(periscope);

    // Side Hydro-Thrusters
    [-0.78, 0.78].forEach((tz) => {
      const pod = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 0.7, 14), darkCarbon);
      pod.rotation.z = Math.PI / 2;
      pod.position.set(-0.35, -0.12, tz);
      subGroup.add(pod);
    });

    // Rear Shroud & Animated Rotor Blades
    const shroud = new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.06, 12, 24), darkCarbon);
    shroud.position.x = -1.55;
    shroud.rotation.y = Math.PI / 2;
    subGroup.add(shroud);

    const propeller = new THREE.Group();
    propeller.position.x = -1.55;
    for (let b = 0; b < 4; b++) {
      const blade = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.56, 0.11), yellowHull);
      blade.rotation.x = (b * Math.PI) / 2;
      blade.rotation.y = 0.35;
      propeller.add(blade);
    }
    subGroup.add(propeller);

    // Volumetric Twin Headlights (SpotLight + Light Cones)
    const headSpot = new THREE.SpotLight(0xdff7ff, 18, 28, Math.PI / 5.5, 0.55, 1.2);
    headSpot.position.set(1.35, -0.1, 0);
    headSpot.target.position.set(10, -2.5, 0);
    headSpot.castShadow = true;
    subGroup.add(headSpot);
    subGroup.add(headSpot.target);

    const beamGeo = new THREE.ConeGeometry(2.4, 11, 20, 1, true);
    beamGeo.translate(0, -5.5, 0);
    beamGeo.rotateZ(Math.PI / 2);
    const beamMat = new THREE.MeshBasicMaterial({
      color: 0xbbeeff,
      transparent: true,
      opacity: 0.09,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      side: THREE.DoubleSide
    });
    const lightCone = new THREE.Mesh(beamGeo, beamMat);
    lightCone.position.set(1.35, -0.1, 0);
    subGroup.add(lightCone);

    // Orient submarine facing forward (-Z)
    const subVisual = new THREE.Group();
    subVisual.add(...subGroup.children);
    subVisual.rotation.y = Math.PI / 2;
    subGroup.add(subVisual);

    // 9. CINEMATIC SUNKEN GALLEON WRECKAGE
    const wreckGroup = new THREE.Group();
    const agedOak = new THREE.MeshStandardMaterial({
      color: 0x3b2d23,
      bumpMap: sandBump,
      bumpScale: 0.12,
      roughness: 0.95
    });
    const hullPlanks = new THREE.Mesh(new THREE.BoxGeometry(7.5, 1.8, 2.6), agedOak);
    hullPlanks.castShadow = true;
    hullPlanks.receiveShadow = true;
    wreckGroup.add(hullPlanks);

    // Ribbed ship frames
    for (let r = -3; r <= 3; r += 1.2) {
      const rib = new THREE.Mesh(new THREE.TorusGeometry(1.35, 0.1, 8, 16, Math.PI), agedOak);
      rib.position.set(r, 0.8, 0);
      rib.rotation.y = Math.PI / 2;
      rib.rotation.z = Math.PI;
      wreckGroup.add(rib);
    }
    const brokenMast = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.16, 4.8, 10), agedOak);
    brokenMast.position.set(0.8, 2.2, 0);
    brokenMast.rotation.z = 0.25;
    wreckGroup.add(brokenMast);

    wreckGroup.position.set(14, -4.1, -18);
    wreckGroup.rotation.set(0.08, -0.55, -0.14);
    scene.add(wreckGroup);

    // 10. RADIANT ANCIENT RELICS (TREASURES WITH POINT LIGHTS & ORBITING RINGS)
    const lootItems = [];
    const relicMat = new THREE.MeshStandardMaterial({
      color: 0xffe066,
      emissive: 0xff9900,
      emissiveIntensity: 1.4,
      metalness: 0.9,
      roughness: 0.12
    });
    const ringMat = new THREE.MeshBasicMaterial({ color: 0x7ef9ff });

    for (let idx = 0; idx < TOTAL_TREASURES; idx++) {
      const item = new THREE.Group();
      const crystal = new THREE.Mesh(new THREE.OctahedronGeometry(0.52, 0), relicMat);
      const outerRing = new THREE.Mesh(new THREE.TorusGeometry(0.82, 0.03, 10, 32), ringMat);
      const innerRing = new THREE.Mesh(new THREE.TorusGeometry(0.66, 0.025, 10, 32), ringMat);
      innerRing.rotation.x = Math.PI / 2;

      const glow = new THREE.PointLight(0xffbe3b, 3.2, 9);
      item.add(crystal, outerRing, innerRing, glow);

      const angle = (idx / TOTAL_TREASURES) * Math.PI * 2 + 0.5;
      const dist = 9 + (idx % 3) * 5.5;
      item.position.set(
        Math.cos(angle) * dist,
        -2.2 + (idx % 3) * 1.3,
        Math.sin(angle) * dist - 4
      );
      scene.add(item);
      lootItems.push({ group: item, outerRing, innerRing });
    }

    // 11. DYNAMIC BIOLOGICAL FISH SCHOOLS & 450 GPU-INSTANCED REEF FISH
    const school = [];
    for (let idx = 0; idx < 28; idx++) {
      const fishGroup = new THREE.Group();
      const bodyMat = new THREE.MeshStandardMaterial({
        color: idx % 3 === 0 ? 0x38bdf8 : idx % 3 === 1 ? 0xfb923c : 0xfacc15,
        metalness: 0.35,
        roughness: 0.3
      });
      const body = new THREE.Mesh(new THREE.ConeGeometry(0.16, 0.62, 8), bodyMat);
      body.rotation.x = Math.PI / 2;
      const tail = new THREE.Mesh(new THREE.ConeGeometry(0.14, 0.24, 4), bodyMat);
      tail.rotation.x = -Math.PI / 2;
      tail.position.z = -0.36;
      fishGroup.add(body, tail);

      fishGroup.position.set(
        (Math.random() - 0.5) * 38,
        -2 + Math.random() * 7,
        (Math.random() - 0.5) * 38
      );
      scene.add(fishGroup);
      school.push({
        group: fishGroup,
        tail,
        radius: 4 + Math.random() * 8,
        speed: 0.4 + Math.random() * 0.5,
        centerX: fishGroup.position.x,
        centerZ: fishGroup.position.z,
        phase: Math.random() * Math.PI * 2
      });
    }

    // 450 GPU-Instanced Reef Fish
    const ambientFishCount = 450;
    const miniFishGeo = new THREE.ConeGeometry(0.065, 0.28, 6);
    miniFishGeo.rotateX(Math.PI / 2); // Point fish nose along +Z for lookAt()
    const miniFishMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      metalness: 0.45,
      roughness: 0.25
    });
    const ambientFishMesh = new THREE.InstancedMesh(miniFishGeo, miniFishMat, ambientFishCount);
    ambientFishMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);

    const ambientFishData = [];
    const dummyFish = new THREE.Object3D();
    const fishColor = new THREE.Color();
    const reefPalette = [0x38bdf8, 0x2dd4bf, 0xfacc15, 0xfb923c, 0xa78bfa, 0x7dd3fc];

    for (let i = 0; i < ambientFishCount; i++) {
      const cx = (Math.random() - 0.5) * 58;
      const cy = -4.2 + Math.random() * 16.5;
      const cz = (Math.random() - 0.5) * 58;
      const radius = 1.5 + Math.random() * 5.5;
      const speed = 0.35 + Math.random() * 0.75;
      const phase = Math.random() * Math.PI * 2;
      const scale = 0.65 + Math.random() * 0.85;

      ambientFishData.push({ cx, cy, cz, radius, speed, phase, scale });
      fishColor.setHex(reefPalette[i % reefPalette.length]);
      ambientFishMesh.setColorAt(i, fishColor);
    }
    ambientFishMesh.instanceColor.needsUpdate = true;
    scene.add(ambientFishMesh);

    // 12. SMOOTH INERTIA PHYSICS, CONTROLS & CAMERA RIG
    const activeInputs = {};
    const velocity = new THREE.Vector3();
    let yaw = 0;
    let lightsOn = true;
    let collectedCount = 0;
    let gameRunning = false;

    const keyMap = {
      w: "forward", ArrowUp: "forward",
      s: "back", ArrowDown: "back",
      a: "left", ArrowLeft: "left",
      d: "right", ArrowRight: "right",
      q: "rise", e: "dive",
      Shift: "boost"
    };

    const toggleInput = (action, pressed) => {
      activeInputs[action] = pressed;
    };

    document.querySelectorAll("[data-key]").forEach((btn) => {
      const action = btn.dataset.key;
      btn.addEventListener("pointerdown", (evt) => {
        evt.preventDefault();
        toggleInput(action, true);
      });
      ["pointerup", "pointerleave", "pointercancel"].forEach((eventName) => {
        btn.addEventListener(eventName, () => toggleInput(action, false));
      });
    });

    window.addEventListener("keydown", (evt) => {
      if (evt.key.toLowerCase() === "l") {
        lightsOn = !lightsOn;
        headSpot.visible = lightsOn;
        lightCone.visible = lightsOn;
      }
      const action = keyMap[evt.key];
      if (action) toggleInput(action, true);
    });

    window.addEventListener("keyup", (evt) => {
      const action = keyMap[evt.key];
      if (action) toggleInput(action, false);
    });

    startButton.addEventListener("click", () => {
      gameRunning = true;
      overlay.style.display = "none";
    });

    function finishMission() {
      dialogBox.innerHTML =
        '<div class="badge">Expedition Complete</div>' +
        '<h1>All Relics Recovered!</h1>' +
        '<p>Incredible piloting, Captain. Every sunken relic has been secured from the abyssal reef.</p>' +
        '<button type="button" id="again">Dive Again</button>';
      overlay.style.display = "flex";
      gameRunning = false;

      const retryBtn = document.getElementById("again");
      if (retryBtn) {
        retryBtn.addEventListener("click", () => window.location.reload());
      }
    }

    // 13. MAIN 60FPS ANIMATION LOOP
    const clock = new THREE.Clock();
    let causticTimer = 0;

    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), 0.05);
      const elapsed = clock.elapsedTime;

      // Update animated water caustics at ~24fps for razor-sharp visuals + high framerate
      causticTimer += dt;
      if (causticTimer > 0.042) {
        updateCaustics(elapsed);
        causticTimer = 0;
      }

      // Gently sway volumetric god-rays & kelp
      godRays.forEach((r) => {
        r.mesh.material.opacity = 0.045 + Math.sin(elapsed * 1.1 + r.phase) * 0.018;
      });
      kelpStalks.forEach((k) => {
        k.mesh.rotation.z = Math.sin(elapsed * 1.6 + k.phase) * 0.14;
        k.mesh.rotation.x = Math.cos(elapsed * 1.2 + k.phase) * 0.08;
      });

      // Animate 450 instanced reef fish swimming & wiggling
      for (let i = 0; i < ambientFishCount; i++) {
        const f = ambientFishData[i];
        const angle = elapsed * f.speed + f.phase;
        const x = f.cx + Math.cos(angle) * f.radius;
        const y = f.cy + Math.sin(elapsed * 1.6 + f.phase) * 0.45;
        const z = f.cz + Math.sin(angle) * f.radius;

        const nextAngle = angle + 0.08;
        const nx = f.cx + Math.cos(nextAngle) * f.radius;
        const nz = f.cz + Math.sin(nextAngle) * f.radius;

        dummyFish.position.set(x, y, z);
        dummyFish.lookAt(nx, y, nz);
        dummyFish.rotateY(Math.sin(elapsed * 14 + f.phase) * 0.22); // Swimming tail-body wiggle
        dummyFish.scale.setScalar(f.scale);
        dummyFish.updateMatrix();
        ambientFishMesh.setMatrixAt(i, dummyFish.matrix);
      }
      ambientFishMesh.instanceMatrix.needsUpdate = true;

      // Spin propeller faster when thrusting
      const isThrusting = activeInputs.forward || activeInputs.back || activeInputs.rise || activeInputs.dive;
      propeller.rotation.x += dt * (isThrusting ? (activeInputs.boost ? 28 : 16) : 5);

      if (gameRunning) {
        const accel = activeInputs.boost ? 14 : 7.5;
        const turnSpeed = 1.9;

        if (activeInputs.left) yaw += turnSpeed * dt;
        if (activeInputs.right) yaw -= turnSpeed * dt;

        const forwardVec = new THREE.Vector3(-Math.sin(yaw), 0, -Math.cos(yaw));
        if (activeInputs.forward) velocity.addScaledVector(forwardVec, accel * dt);
        if (activeInputs.back) velocity.addScaledVector(forwardVec, -accel * 0.65 * dt);
        if (activeInputs.rise) velocity.y += accel * 0.75 * dt;
        if (activeInputs.dive) velocity.y -= accel * 0.75 * dt;

        // Hydrodynamic water drag
        velocity.multiplyScalar(Math.pow(0.08, dt));
        subGroup.position.addScaledVector(velocity, dt);

        // Arena boundaries
        subGroup.position.x = THREE.MathUtils.clamp(subGroup.position.x, -26, 26);
        subGroup.position.z = THREE.MathUtils.clamp(subGroup.position.z, -26, 26);
        subGroup.position.y = THREE.MathUtils.clamp(subGroup.position.y, -4.1, 8.5);

        // Realistic banking, pitching & hover bobbing
        subGroup.rotation.y = yaw;
        const targetRoll = activeInputs.left ? 0.18 : activeInputs.right ? -0.18 : 0;
        const targetPitch = THREE.MathUtils.clamp(velocity.y * 0.06, -0.25, 0.25);
        subVisual.rotation.z = THREE.MathUtils.lerp(subVisual.rotation.z, targetPitch, 0.1);
        subVisual.rotation.x = THREE.MathUtils.lerp(subVisual.rotation.x, targetRoll, 0.1);

        // Update live depth HUD
        const depthMeters = Math.round(42 - subGroup.position.y * 3.5);
        depthDisplay.textContent = `DEPTH: ${depthMeters}m`;

        // Treasure animation & collection
        for (let idx = lootItems.length - 1; idx >= 0; idx--) {
          const item = lootItems[idx];
          item.group.rotation.y += dt * 1.2;
          item.outerRing.rotation.x += dt * 1.8;
          item.innerRing.rotation.y -= dt * 2.2;
          item.group.position.y += Math.sin(elapsed * 2.4 + idx) * 0.003;

          if (item.group.position.distanceTo(subGroup.position) < PICKUP_RADIUS) {
            scene.remove(item.group);
            lootItems.splice(idx, 1);
            collectedCount += 1;
            scoreDisplay.textContent = String(collectedCount);

            if (collectedCount === TOTAL_TREASURES) {
              finishMission();
            }
          }
        }
      }

      // Swimming fish schools
      school.forEach((f) => {
        const a = elapsed * f.speed + f.phase;
        const nx = f.centerX + Math.cos(a) * f.radius;
        const nz = f.centerZ + Math.sin(a) * f.radius;
        f.group.lookAt(nx, f.group.position.y, nz);
        f.group.position.set(nx, f.group.position.y + Math.sin(elapsed * 2 + f.phase) * 0.004, nz);
        f.tail.rotation.y = Math.sin(elapsed * 12 + f.phase) * 0.45;
      });

      // Cinematic Chase Camera behind the Submarine
      const camOffset = new THREE.Vector3(
        Math.sin(yaw) * 8.5,
        3.1,
        Math.cos(yaw) * 8.5
      );
      const desiredCam = subGroup.position.clone().add(camOffset);
      camera.position.lerp(desiredCam, 0.075);

      const lookTarget = subGroup.position.clone().add(
        new THREE.Vector3(-Math.sin(yaw) * 3.5, 0.3, -Math.cos(yaw) * 3.5)
      );
      camera.lookAt(lookTarget);

      composer.render();
    }

    animate();

    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      composer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
